menu "Client Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "ESP32_S3_Display"
        help
            SSID of the WiFi network.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "12345678"
        help
            Password for the WiFi network.

    config TCP_SERVER_IP
        string "TCP Server IP"
        default "192.168.4.1"
        help
            IP address of the TCP server.

    config TCP_SERVER_PORT
        int "TCP Server Port"
        default 8888
        help
            Port of the TCP server.

    config DEVICE_NAME
        string "Device Name (English)"
        default "pomodoro"
        help
            Name of the device (used in JSON and log files). Use only English letters.

    config COMMAND_PORT
        int "Command Server Port"
        default 8889
        help
            Port on which the device listens for commands from the server.

    config MOISTURE_THRESHOLD_PERCENT
        int "Moisture threshold for pump activation (%)"
        default 60
        range 0 100
        help
            Soil moisture level below which the pump may be activated.

    config DRY_MV
        int "Dry value (ADC) for HW-390"
        default 80
        range 0 100
        help
            Raw ADC reading (0-100) corresponding to dry soil. 
            Note: This is not actual millivolts, but a scaled value (0-100) from the sensor.

    config WET_MV
        int "Wet value (ADC) for HW-390"
        default 50
        range 0 100
        help
            Raw ADC reading (0-100) corresponding to wet soil.
            Note: This is not actual millivolts, but a scaled value (0-100) from the sensor.

endmenu